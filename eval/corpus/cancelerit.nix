{ config, lib, pkgs, ... }:

{
  # Данный модуль осуществляет реализацию настройки сетевого взаимодействия хоста.
  networking = {
    # Установка значения hostName производится в соответствии с именем машины.
    hostName = "deep-thought";
    # Осуществляется включение межсетевого экрана для обеспечения защиты периметра.
    firewall.enable = true;
    # Производится настройка разрешения доменных имён через локальный резолвер.
    nameservers = [ "127.0.0.1" ];
  };

  # Включение данной опции приводит к осуществлению автоматической очистки хранилища.
  nix.gc = {
    automatic = true;
    # Осуществление запуска очистки производится один раз в неделю.
    dates = "weekly";
  };
}
